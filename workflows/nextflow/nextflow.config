plugins {
  id 'nf-google'
  id 'nf-wave'
}

docker {
  enabled = true
  runOptions = ''
}

process {
  errorStrategy = 'retry'
  maxRetries = 2
  withName: BAM_TO_BED {
    // CPU & memory are set in the pipeline via params
  }
  withName: JUNCTIONS {
    // CPU & memory are set in the pipeline via params
  }
}

// Default local profile
profiles {
  local {
    process.executor = 'local'
    workDir = 'work'
    wave.enabled = false
  }

  // Google Batch (keeps data in GCS; recommended for GTEx locality)
  google_batch {
    process.executor = 'google-batch'
    workDir = 'gs://YOUR_WORKSPACE_BUCKET/nextflow-work'
    wave.enabled = true
    fusion.enabled = true
    google {
      project = 'YOUR_GCP_PROJECT'
      location = 'us-central1'
      // serviceAccountEmail = 'service-account@YOUR_GCP_PROJECT.iam.gserviceaccount.com'
    }
  }
}
